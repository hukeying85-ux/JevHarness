; Martini 3 NVT pre-equilibration, 100 ps (doc §8/§9: EM -> 100 ps NVT -> 1 ns NPT)
; no -DPOSRES: the one-pot aggregation arm must not pin the copies
integrator        = md
dt                = 0.02
nsteps            = 5000
nstlist           = 20
cutoff-scheme     = Verlet
pbc               = xyz
coulombtype       = reaction-field
epsilon_r         = 15
rcoulomb          = 1.1
vdwtype           = Cut-off
rvdw              = 1.1
vdw-modifier      = Potential-shift
constraints       = none
tcoupl            = v-rescale
tc-grps           = System
tau-t             = 1.0
ref-t             = 310
gen-vel           = yes
gen-temp          = 310
gen-seed          = -1
nstxout-compressed = 5000
nstenergy         = 500
nstlog            = 500

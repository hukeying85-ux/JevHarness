; Martini 3 production, Parrinello-Rahman tau-p = 12 ps, 1 ns frame spacing (doc §12)
integrator        = md
dt                = 0.02
nsteps            = 2500000
nstlist           = 20
cutoff-scheme     = Verlet
pbc               = xyz
coulombtype       = reaction-field
epsilon_r         = 15
rcoulomb          = 1.1
vdwtype           = Cut-off
rvdw              = 1.1
vdw-modifier      = Potential-shift
constraints       = none
tcoupl            = v-rescale
tc-grps           = System
tau-t             = 1.0
ref-t             = 310
pcoupl            = Parrinello-Rahman
tau-p             = 12.0
ref-p             = 1.0
compressibility   = 3e-4
continuation      = yes
gen-vel           = no
nstxout-compressed = 50000
nstenergy         = 5000
nstlog            = 5000

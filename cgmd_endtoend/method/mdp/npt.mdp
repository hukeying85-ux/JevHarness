; Martini 3 NPT equilibration, 1 ns, c-rescale (doc §12)
; no -DPOSRES: the one-pot aggregation arm must not pin the copies
integrator        = md
dt                = 0.02
nsteps            = 50000
nstlist           = 20
cutoff-scheme     = Verlet
pbc               = xyz
coulombtype       = reaction-field
epsilon_r         = 15
rcoulomb          = 1.1
vdwtype           = Cut-off
rvdw              = 1.1
vdw-modifier      = Potential-shift
constraints       = none
tcoupl            = v-rescale
tc-grps           = System
tau-t             = 1.0
ref-t             = 310
pcoupl            = c-rescale
tau-p             = 4.0
ref-p             = 1.0
compressibility   = 3e-4
continuation      = yes
gen-vel           = no
nstxout-compressed = 5000
nstenergy         = 500
nstlog            = 500
